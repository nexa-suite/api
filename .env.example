NEXA_DATABASE_URL=jdbc:postgresql://localhost:5432/nexa
NEXA_DATABASE_USERNAME=nexa
NEXA_DATABASE_PASSWORD=
NEXA_SECURITY_ISSUER=http://localhost:8080
NEXA_SECURITY_AUDIENCE=nexa-local
